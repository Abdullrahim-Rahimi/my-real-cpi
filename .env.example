# Public — sent to the browser. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — used by the cron ingestion route. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional API keys for CPI ingestion. The ingestion route will skip a source
# if its key is missing.
BLS_API_KEY=                # https://www.bls.gov/developers/  (US CPI)

# Vercel Cron auth — any random string. Vercel sets the Authorization header
# to "Bearer <CRON_SECRET>" when calling /api/cron/* routes.
CRON_SECRET=change-me-to-a-long-random-string

# Optional — hCaptcha for sybil resistance on role applications.
# When unset, captcha checks are skipped (the system still works fine).
# Sign up at https://www.hcaptcha.com to get keys.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Optional — Mailgun for transactional email notifications (community
# pipeline events: applications, batch state changes, etc.). When unset,
# notify functions log a warning and skip sending.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
# MAILGUN_FROM=My Real CPI <noreply@myrealcpi.com>

# Required when emails are enabled — HMAC secret used to sign one-click
# unsubscribe tokens embedded in personal-CPI emails. Rotate to invalidate
# all live links. Generate with:  openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=
